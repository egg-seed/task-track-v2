# Copy to .env for local development: cp .env.example .env
# .env is ignored by Git, Docker (.dockerignore), and `fastapi deploy`.
# Never put production secrets in .env; set them in the platform instead.

# development | test | production. production refuses to start without a server DB.
TASKS_ENV=development

# Leave unset to use sqlite:///./tasks.db. FastAPI Cloud's Neon integration sets DATABASE_URL.
# TASKS_DATABASE_URL=postgresql://tasks:devpass@localhost:5432/tasks

# DEBUG | INFO | WARNING | ERROR | CRITICAL
TASKS_LOG_LEVEL=INFO
